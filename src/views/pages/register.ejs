<div class="min-h-screen flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-md bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-brand-lime flex items-center justify-center mx-auto mb-4">
        <i data-lucide="user-plus" class="w-8 h-8 text-brand-forest"></i>
      </div>
      <h1 class="text-2xl font-bold text-text-main">Buat Akun Baru</h1>
      <p class="text-text-muted text-sm mt-1">Mulai kelola keuangan cerdas</p>
    </div>

    <% if (error) { %>
      <div class="mb-4 p-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm" role="alert">
        <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST" class="space-y-4">
      <div>
        <label for="username" class="block text-sm font-medium text-text-main mb-1">Username</label>
        <input type="text" id="username" name="username" required autocomplete="username"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main 
                      focus:border-brand-forest focus:ring-2 focus:ring-brand-forest/20 focus:ring-offset-0 
                      transition-colors outline-none placeholder:text-text-muted"
               placeholder="username_anda"
               minlength="3" maxlength="50">
        <p class="text-xs text-text-muted mt-1">Minimal 3 karakter, hanya huruf, angka, underscore</p>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-text-main mb-1">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main 
                      focus:border-brand-forest focus:ring-2 focus:ring-brand-forest/20 focus:ring-offset-0 
                      transition-colors outline-none placeholder:text-text-muted"
               placeholder="contoh@email.com">
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-text-main mb-1">Password</label>
        <input type="password" id="password" name="password" required autocomplete="new-password"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main 
                      focus:border-brand-forest focus:ring-2 focus:ring-brand-forest/20 focus:ring-offset-0 
                      transition-colors outline-none placeholder:text-text-muted"
               placeholder="••••••••"
               minlength="6">
        <p class="text-xs text-text-muted mt-1">Minimal 6 karakter</p>
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-text-main mb-1">Konfirmasi Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main 
                      focus:border-brand-forest focus:ring-2 focus:ring-brand-forest/20 focus:ring-offset-0 
                      transition-colors outline-none placeholder:text-text-muted"
               placeholder="••••••••">
      </div>

      <div>
        <label for="monthlyBudget" class="block text-sm font-medium text-text-main mb-1">Budget Bulanan Target (Opsional)</label>
        <input type="number" id="monthlyBudget" name="monthlyBudget" autocomplete="off"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main 
                      focus:border-brand-forest focus:ring-2 focus:ring-brand-forest/20 focus:ring-offset-0 
                      transition-colors outline-none placeholder:text-text-muted"
               placeholder="1500000"
               min="0" step="1000">
        <p class="text-xs text-text-muted mt-1">Default: Rp 1.500.000</p>
      </div>

      <button type="submit"
              class="w-full py-3 rounded-full bg-brand-forest text-white font-medium text-sm
                     hover:bg-green-900 transition-colors focus:ring-2 focus:ring-brand-forest/30 focus:ring-offset-2">
        Daftar
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-text-muted">
      Sudah punya akun? 
      <a href="/login" class="text-brand-forest font-medium hover:underline">Login di sini</a>
    </p>
  </div>
</div>