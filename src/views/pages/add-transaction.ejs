<div class="max-w-md mx-auto bg-surface rounded-3xl p-6 sm:p-8 shadow-sm">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-text-main"><%= type === 'income' ? 'Tambah Pemasukan' : 'Catat Pengeluaran' %></h1>
      <p class="text-sm text-text-muted mt-1"><%= type === 'income' ? 'Manual deposit saldo' : 'Input pengeluaran manual' %></p>
    </div>
    <a href="/dashboard" class="px-4 py-2 rounded-full border border-gray-200 text-sm font-medium text-text-main hover:bg-gray-50 transition-colors">
      Batal
    </a>
  </div>

  <% if (error) { %>
    <div class="mb-4 p-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm" role="alert">
      <%= error %>
    </div>
  <% } %>

  <form action="/transactions/add" method="POST" class="space-y-5">
    <input type="hidden" name="type" value="<%= type %>">

    <div>
      <label for="amount" class="block text-sm font-medium text-text-main mb-1">Nominal (Rp) <span class="text-red-500">*</span></label>
      <input type="number" id="amount" name="amount" required min="1" step="any"
             class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main focus:border-brand-forest focus:ring-0 outline-none tabular-nums"
             placeholder="<%= type === 'income' ? '1500000' : '25000' %>"
             autocomplete="off">
    </div>

    <% if (type === 'expense') { %>
      <div>
        <label for="category" class="block text-sm font-medium text-text-main mb-1">Kategori <span class="text-red-500">*</span></label>
        <select id="category" name="category" required
                class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main focus:border-brand-forest focus:ring-0 outline-none">
          <option value="Kos">🏠 Kos</option>
          <option value="Makan" selected>🍜 Makan</option>
          <option value="Tugas/Print">📄 Tugas/Print</option>
          <option value="Nongkrong">☕ Nongkrong</option>
          <option value="Transportasi">🛵 Transportasi</option>
          <option value="Lainnya">📦 Lainnya</option>
        </select>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-text-main mb-1">Keterangan (Opsional)</label>
        <input type="text" id="description" name="description"
               class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main focus:border-brand-forest focus:ring-0 outline-none"
               placeholder="Contoh: Beli nasi goreng / Bayar listrik kos">
      </div>
    <% } else { %>
      <input type="hidden" name="category" value="Lainnya">
      <input type="hidden" name="description" value="Manual Deposit (Top Up Saldo)">
    <% } %>

    <div>
      <label for="transactionDate" class="block text-sm font-medium text-text-main mb-1">Tanggal <span class="text-red-500">*</span></label>
      <input type="date" id="transactionDate" name="transactionDate" required
             class="w-full px-4 py-3 rounded-2xl border border-gray-200 bg-white text-text-main focus:border-brand-forest focus:ring-0 outline-none tabular-nums">
    </div>

    <button type="submit"
            class="w-full py-3 rounded-full bg-brand-forest text-white font-medium text-sm
                   hover:bg-green-900 transition-colors flex items-center justify-center gap-2">
      <i data-lucide="check" class="w-5 h-5"></i>
      <%= type === 'income' ? 'Simpan Pemasukan' : 'Simpan Pengeluaran' %>
    </button>
  </form>

  <div class="mt-6 pt-4 border-t border-gray-200">
    <p class="text-xs text-text-muted text-center">
      <%= type === 'income' ? 'Saldo akan bertambah secara langsung' : 'Pastikan saldo mencukupi sebelum menyimpan' %>
    </p>
  </div>
</div>

<script>
  document.getElementById('transactionDate').value = new Date().toISOString().split('T')[0];
</script>