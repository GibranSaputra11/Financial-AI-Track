<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md bg-white rounded-3xl p-8 text-center shadow-sm border border-gray-100">
    <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
      <i data-lucide="alert-triangle" class="w-8 h-8 text-red-500"></i>
    </div>
    <h1 class="text-2xl font-bold text-text-main mb-2">Terjadi Kesalahan</h1>
    <p class="text-text-muted mb-6"><%= message %></p>

    <% if (error && process.env.NODE_ENV === 'development') { %>
      <details class="text-left mb-6">
        <summary class="text-sm text-text-muted cursor-pointer">Detail Error (Development)</summary>
        <pre class="mt-2 p-3 bg-gray-100 rounded-xl text-xs overflow-auto text-red-600"><%= JSON.stringify(error, null, 2) %></pre>
      </details>
    <% } %>

    <div class="flex gap-3 justify-center">
      <a href="/dashboard" class="flex-1 px-4 py-2 rounded-full bg-brand-forest text-white text-sm font-medium hover:bg-green-900">
        Kembali ke Dashboard
      </a>
      <a href="/login" class="flex-1 px-4 py-2 rounded-full border border-gray-200 text-brand-forest text-sm font-medium hover:bg-gray-50">
        Login Ulang
      </a>
    </div>
  </div>
</div>